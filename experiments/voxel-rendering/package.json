{
  "name": "@antiky/research-voxel-rendering",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fixture": "node --experimental-strip-types --experimental-transform-types scripts/write-built-in-vox.ts",
    "measure": "node --experimental-strip-types --experimental-transform-types scripts/measure-scene.ts",
    "dev": "npm run fixture && npm run shaders && vite --host 127.0.0.1 --port 4178",
    "antiky:dev": "vite build --watch --config vite.antiky.config.ts",
    "antiky:build": "npm run shaders:prod && tsc --noEmit && vite build --config vite.antiky.config.ts",
    "build": "npm run fixture && npm run shaders:prod && tsc --noEmit && vite build",
    "shaders": "brometal dev --once",
    "shaders:watch": "brometal dev",
    "shaders:prod": "brometal prod",
    "test": "npm run fixture && npm run shaders:prod && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "brometal": "0.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.8.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
