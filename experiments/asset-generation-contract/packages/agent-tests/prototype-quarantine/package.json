{
  "name": "@antiky/contracts-agent-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated, evidence-producing agent benchmarks for the shipped Antiky contract DSL.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "contracts-agent-tests": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tasks",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "oxlint src test vitest.config.ts",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@antiky/contracts": "0.1.0",
    "@antiky/contracts-examples": "0.1.0"
  }
}
