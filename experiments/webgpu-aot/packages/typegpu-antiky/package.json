{
  "name": "typegpu-antiky",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./shader": {
      "types": "./src/definition.ts",
      "import": "./dist/definition.js"
    }
  },
  "bin": {
    "typegpu-antiky": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/definition.ts src/cli.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outdir=dist",
    "test": "vitest run"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "typegpu": "0.11.9",
    "unplugin-typegpu": "0.11.6"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
