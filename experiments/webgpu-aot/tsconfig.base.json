{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@webgpu/types",
      "node"
    ],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
